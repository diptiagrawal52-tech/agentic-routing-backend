profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the renter of the repository
#   will have their own version of python.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if different OSes are used, Pipfile.lock may not be shared.
# Pipfile.lock

# poetry
#   Similar to Pipenv, poetry.lock is generally recommended to be committed.
# poetry.lock

# pdm
#   Similar to Pipenv and Poetry, pdm.lock is generally recommended to be committed.
# pdm.lock

# virtualenv
.venv/
venv/
ENV/
env/
# Environment files
.env
.env.*

# IDEs
.vscode/
.idea/
*.swp
*.swo
